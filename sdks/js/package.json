{
  "name": "@oei/exercise-sdk",
  "version": "1.0.0",
  "description": "Open Exercise Intelligence — JavaScript/TypeScript SDK",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.esm.js",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc && node scripts/build-esm.js",
    "test": "node --test src/**/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["exercise", "fitness", "open-source", "oei"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CHAITANYA2605/open-exercise-intelligence"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
