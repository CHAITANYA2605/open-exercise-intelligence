  "execution": {
    "starting_position": "Stand with heels raised on a 25lb plate or squat wedge, feet shoulder-width apart. Hold a dumbbell vertically at chest height with both hands cupping the top end.",
    "setup_instructions": "Place a 25lb plate flat on the floor. Stand on it with just the heels. Hold a dumbbell at chest height.",
    "steps": [
      "Step 1: Brace your core and keep the dumbbell tight to your chest throughout.",
      "Step 2: Push your hips back and down, keeping the torso upright.",
      "Step 3: Descend to full depth or until thighs are parallel to the floor.",
      "Step 4: Drive through the entire foot to stand, squeezing the glutes at lockout."
    ],
    "breathing_instructions": "Inhale as you descend. Exhale on the way up.",
    "common_mistakes": [
      "Letting the knees cave inward at the bottom",
      "Leaning the torso excessively forward"
    ],
    "safety_considerations": [
      "Ensure the plate or wedge is stable and will not slip before adding significant load"
    ],
    "range_of_motion_guidance": "Aim for full depth (hips below knees). The heel elevation makes this more accessible for those with limited ankle mobility.",
    "tempo_recommendations": "2-1-2-0",
    "coaching_cues": [
      "Sit between your heels",
      "Chest up, elbows down"
    ]
