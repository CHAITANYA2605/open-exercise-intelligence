  "execution": {
    "starting_position": "Hold a dumbbell at chest height in a goblet position or at both sides. Descend into a deep squat position with feet shoulder-width apart.",
    "setup_instructions": "Select a moderate weight. Clear a straight path of at least 10 to 15 meters. Begin in a deep squat.",
    "steps": [
      "Step 1: Lower into a deep squat, keeping your chest up and feet flat on the floor.",
      "Step 2: Take small deliberate steps forward while maintaining the low squat position throughout.",
      "Step 3: Keep knees tracking over your toes with each step.",
      "Step 4: Continue for the prescribed distance or duration, then stand to rest."
    ],
    "breathing_instructions": "Breathe rhythmically throughout. Short breaths are normal due to trunk compression.",
    "common_mistakes": [
      "Allowing the hips to rise during the walk, reducing the squat depth",
      "Letting the heels come off the floor"
    ],
    "safety_considerations": [
      "Avoid if you have significant patellar tendinopathy or acute knee injuries",
      "Start with bodyweight before adding load"
    ],
    "range_of_motion_guidance": "Maintain thighs at or below parallel throughout the entire walk.",
    "tempo_recommendations": "Continuous movement \u2014 deliberate steps",
    "coaching_cues": [
      "Stay low throughout",
      "Knees track over toes on every step"
    ]
  },
